{
  "name": "fashion-hub",
  "version": "0.1.0",
  "private": true,
  "description": "FASHION HUB - luxury fashion & lifestyle storefront (static Next.js export for GitHub Pages)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve:export": "node scripts/serve-export.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "images": "tsx scripts/generate-images.ts",
    "check:export": "node scripts/check-export.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:export",
    "catalogue:import": "tsx scripts/import-catalogue.ts",
    "images:optimize": "tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
